---
import { stackGroups } from "../data/content";
---

<section id="stack">
  <div class="wrap">
    <div class="reveal">
      <span class="kicker">Core Capabilities</span>
      <h2 class="section-title">The Engineering Toolbox.</h2>
      <p class="section-sub">
        Battle-tested across 20+ shipped products. Curated for lightning developer velocity,
        uncompromising client-side performance, and absolute system reliability.
      </p>
    </div>

    <div class="stack-bento">
      {stackGroups.map((group, idx) => (
        <div class="stack-card reveal" style={`--d: ${idx * 0.1}s`} data-tilt>
          <div class="stack-header">
            <span class="stack-icon">{group.icon}</span>
            <h3>{group.title}</h3>
          </div>
          <p class="stack-desc">{group.description}</p>
          <div class="stack-pills">
            {group.items.map((item) => (
              <div class="stack-pill">
                <span>{item.name}</span>
                <span class="stack-pill-tag">[{item.tag}]</span>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
