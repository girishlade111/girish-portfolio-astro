---
const items = [
  "Astro", "Next.js", "React", "TypeScript", "Tailwind CSS", "Supabase",
  "Cloudflare", "Vibe Coding", "UI / UX", "AI Builders", "Dev Tools",
  "Compilers", "Agents", "Local-First", "LadeStack",
];
const row = [...items, ...items];
---

<div class="marquee" aria-hidden="true">
  <div class="marquee-track">
    {row.map((t) => (
      <span class="marquee-item">{t}<i>✦</i></span>
    ))}
  </div>
  <div class="marquee-edge left"></div>
  <div class="marquee-edge right"></div>
</div>
