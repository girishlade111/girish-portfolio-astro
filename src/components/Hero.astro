---
import { profile } from "../data/content";
---

<section class="hero">
  <div class="hero-grid-bg"></div>
  <div class="orb orb-1"></div>
  <div class="orb orb-2"></div>
  <div class="orb orb-3"></div>
  <div class="wrap hero-inner">
    <span class="hero-eyebrow enter" style="--d:.05s"><span class="pulse"></span> Open to product-engineering roles</span>
    <h1 class="enter" style="--d:.15s">Girish<br /><span class="accent shimmer">Lade</span></h1>
    <p class="hero-role enter" style="--d:.28s"><strong>Mechanical Engineer → Software Engineer.</strong> Founder of LadeStack.</p>
    <p class="hero-tag enter" style="--d:.4s">
      I&rsquo;m a &ldquo;vibe coder&rdquo; — I direct AI tools and ship like a founder.
      Dozens of products built and shipped: AI builders, dev tools, compilers, agents.
    </p>
    <div class="hero-cta enter" style="--d:.52s">
      <a href="#projects" class="btn btn-primary magnetic">View projects</a>
      <a href="#contact" class="btn btn-ghost magnetic">Get in touch</a>
    </div>
    <div class="hero-stats enter" style="--d:.64s">
      <div class="stat"><b><span class="count" data-count="20">0</span><em>+</em></b><span>Products shipped</span></div>
      <div class="stat"><b><span class="count" data-count="15">0</span><em>+</em></b><span>Original music tracks</span></div>
      <div class="stat"><b><span class="count" data-count="6" data-pad="2">00</span><em>&nbsp;</em></b><span>Phase career plan</span></div>
    </div>
  </div>
  <a href="#about" class="scroll-hint enter" style="--d:.8s" aria-label="Scroll down">
    <span class="scroll-hint-line"></span>
  </a>
</section>
