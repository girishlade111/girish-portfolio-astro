---
import { projects } from "../data/content";
---

<section id="projects">
  <div class="wrap">
    <div class="reveal">
      <span class="kicker">Selected work</span>
      <h2 class="section-title">Things I&rsquo;ve built &amp; shipped.</h2>
      <p class="section-sub">
        A slice of the LadeStack universe — free, local-first, client-side products,
        designed and built end to end.
      </p>
    </div>
    <div class="proj-grid">
      {projects.map((p, i) => (
        <article class="proj reveal" style={`--d:${i * 0.08}s`} data-tilt>
          <div class="proj-top">
            <div>
              <h3>{p.name}</h3>
              <div class="proj-tagline">{p.tagline}</div>
            </div>
            <span class="status">{p.status}</span>
          </div>
          <p class="desc">{p.description}</p>
          <div class="proj-tags">{p.tags.map((t) => <span class="tag">{t}</span>)}</div>
          {p.link && <a class="proj-link" href={p.link} target="_blank" rel="noopener">Visit live</a>}
        </article>
      ))}
    </div>
  </div>
</section>
