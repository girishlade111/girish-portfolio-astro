---
// SoundFX.astro — Lightweight native Web Audio synthesizer for UI haptics
---

<script>
  // Web Audio UI sound generator (Zero external audio files needed)
  class SoundManager {
    private ctx: AudioContext | null = null;
    public enabled: boolean = false;

    constructor() {
      // Check localStorage preference, default to true or false
      const saved = localStorage.getItem("ladestack_sound_fx");
      this.enabled = saved === "true";
      this.bindTriggers();
    }

    private initContext() {
      if (!this.ctx) {
        const AudioCtx = window.AudioContext || (window as any).webkitAudioContext;
        if (AudioCtx) {
          this.ctx = new AudioCtx();
        }
      }
      if (this.ctx && this.ctx.state === "suspended") {
        this.ctx.resume();
      }
    }

    public toggle(): boolean {
      this.enabled = !this.enabled;
      localStorage.setItem("ladestack_sound_fx", String(this.enabled));
      if (this.enabled) {
        this.initContext();
        this.play("chime");
      }
      return this.enabled;
    }

    public play(type: "hover" | "click" | "chime" | "warp" | "toggle") {
      if (!this.enabled) return;
      try {
        this.initContext();
        if (!this.ctx) return;

        const now = this.ctx.currentTime;
        const osc = this.ctx.createOscillator();
        const gain = this.ctx.createGain();

        osc.connect(gain);
        gain.connect(this.ctx.destination);

        if (type === "hover") {
          osc.type = "sine";
          osc.frequency.setValueAtTime(480, now);
          osc.frequency.exponentialRampToValueAtTime(640, now + 0.035);
          gain.gain.setValueAtTime(0.025, now);
          gain.gain.exponentialRampToValueAtTime(0.0001, now + 0.035);
          osc.start(now);
          osc.stop(now + 0.035);
        } else if (type === "click") {
          osc.type = "triangle";
          osc.frequency.setValueAtTime(520, now);
          osc.frequency.exponentialRampToValueAtTime(180, now + 0.06);
          gain.gain.setValueAtTime(0.05, now);
          gain.gain.exponentialRampToValueAtTime(0.0001, now + 0.06);
          osc.start(now);
          osc.stop(now + 0.06);
        } else if (type === "chime") {
          osc.type = "sine";
          osc.frequency.setValueAtTime(587.33, now); // D5
          osc.frequency.setValueAtTime(880, now + 0.07); // A5
          gain.gain.setValueAtTime(0.04, now);
          gain.gain.exponentialRampToValueAtTime(0.0001, now + 0.25);
          osc.start(now);
          osc.stop(now + 0.25);
        } else if (type === "warp") {
          osc.type = "sine";
          osc.frequency.setValueAtTime(320, now);
          osc.frequency.exponentialRampToValueAtTime(960, now + 0.14);
          gain.gain.setValueAtTime(0.035, now);
          gain.gain.exponentialRampToValueAtTime(0.0001, now + 0.14);
          osc.start(now);
          osc.stop(now + 0.14);
        } else if (type === "toggle") {
          osc.type = "sine";
          osc.frequency.setValueAtTime(740, now);
          osc.frequency.exponentialRampToValueAtTime(540, now + 0.05);
          gain.gain.setValueAtTime(0.03, now);
          gain.gain.exponentialRampToValueAtTime(0.0001, now + 0.05);
          osc.start(now);
          osc.stop(now + 0.05);
        }
      } catch (e) {
        // Ignore audio errors if browser blocks auto audio
      }
    }

    private bindTriggers() {
      // Bind hover sounds to interactive elements
      document.addEventListener("mouseover", (e) => {
        const target = e.target as HTMLElement;
        if (target && target.closest("a, button, .tab-btn, .cmd-chip, .proj, .target-chip")) {
          this.play("hover");
        }
      }, { passive: true });

      // Bind click sounds
      document.addEventListener("click", (e) => {
        const target = e.target as HTMLElement;
        if (target && target.closest("a, button, .tab-btn, .cmd-chip, .btn")) {
          this.play("click");
        }
      }, { passive: true });
    }
  }

  // Attach to window
  (window as any).soundManager = new SoundManager();
</script>
